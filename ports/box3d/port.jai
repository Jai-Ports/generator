box3d_port :: () -> Port_Spec {
    return .{
        name = "box3d",
        upstream_url = "https://github.com/erincatto/box3d.git",
        upstream_commit = "9e5a4cde862fba95ff19f096b79567f3ea6c01fd",
        upstream_label = "upstream/box3d",
        license_file = "LICENSE",
        language = .C,
        standard = "gnu17",
        include_directories = string.["include", "src"],
        compiler_flags = string.["-fwrapv", "-ffp-contract=off"],
        modules = Port_Module_Spec.[.{
            output_path = "",
            transpiler_prefix = "b3",
            source_files = string.[
                "src/aabb.c",
                "src/arena_allocator.c",
                "src/bitset.c",
                "src/block_allocator.c",
                "src/body.c",
                "src/broad_phase.c",
                "src/capsule.c",
                "src/compound.c",
                "src/constraint_graph.c",
                "src/contact.c",
                "src/contact_solver.c",
                "src/convex_manifold.c",
                "src/core.c",
                "src/distance.c",
                "src/distance_joint.c",
                "src/dynamic_tree.c",
                "src/height_field.c",
                "src/hull.c",
                "src/id_pool.c",
                "src/island.c",
                "src/joint.c",
                "src/manifold.c",
                "src/math_functions.c",
                "src/mesh.c",
                "src/mesh_contact.c",
                "src/motor_joint.c",
                "src/mover.c",
                "src/name_cache.c",
                "src/parallel_for.c",
                "src/parallel_joint.c",
                "src/physics_world.c",
                "src/prismatic_joint.c",
                "src/recording.c",
                "src/recording_replay.c",
                "src/world_snapshot.c",
                "src/revolute_joint.c",
                "src/scheduler.c",
                "src/sensor.c",
                "src/shape.c",
                "src/simd.c",
                "src/solver.c",
                "src/solver_set.c",
                "src/sphere.c",
                "src/spherical_joint.c",
                "src/table.c",
                "src/timer.c",
                "src/triangle_manifold.c",
                "src/types.c",
                "src/weld_joint.c",
                "src/wheel_joint.c",
            ],
            defines = string.["BOX3D_VALIDATE"],
            generated_entry = "cpp_transpiler_program.jai",
        }],
        output_url = "git@github.com:Jai-Ports/box3d.git",
        supported_target = "linux-x64",
    };
}
