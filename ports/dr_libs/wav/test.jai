main :: () {
    Audio.initialize_program();
    digest := verify_audio();
    // Golden digest independently produced by the pinned upstream C oracle.
    assert(digest == 12364590308568729178);
    print("PARITY dr_wav %\n", digest);
    if array_find(get_command_line_arguments(), "--benchmark") {
        started := seconds_since_init();
        checksum: u64;
        for 0..199 checksum += verify_audio();
        print("BENCH % %\n", seconds_since_init() - started, checksum);
    }
}
verify_audio :: () -> u64 {
    offsets := u64.[0, 2092, 3194, 6368, 10556, 11674];
    lengths := u64.[2092, 1102, 3174, 4188, 1118, 1148];
    digest: u64 = 14695981039346656037;
    for offset, fixture: offsets {
        channels: u32;
        rate: u32;
        frames: u64;
        samples := Audio.open_memory_and_read_pcm_frames_s16(cast(*void) (encoded.data + offset), lengths[fixture], *channels, *rate, *frames, null);
        assert(samples != null);
        defer Audio.free_(cast(*void) samples, null);
        assert(channels == 2 && rate == 44100 && frames > 0);
        digest = (digest ^ channels) * 1099511628211;
        digest = (digest ^ rate) * 1099511628211;
        digest = (digest ^ frames) * 1099511628211;
        for index: 0..cast(s64) (frames * channels) - 1 {
            digest = (digest ^ cast(u64) cast,no_check(u16) samples[index]) * 1099511628211;
        }
    }
    return digest;
}
