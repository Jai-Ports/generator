box2d_port :: () -> Port_Spec {
    return .{
        name = "box2d",
        upstream_url = "https://github.com/erincatto/box2d.git",
        upstream_commit = "77619f4f7baebe5117a2e3ddc3ac8c404e82d243",
        upstream_label = "upstream/box2d",
        license_file = "LICENSE",
        language = .C,
        standard = "gnu17",
        include_directories = string.["include", "src"],
        compiler_flags = string.["-ffp-contract=off"],
        modules = Port_Module_Spec.[.{
            output_path = "",
            transpiler_prefix = "b2",
            source_files = string.[
                "src/aabb.c",
                "src/arena_allocator.c",
                "src/bitset.c",
                "src/body.c",
                "src/broad_phase.c",
                "src/constraint_graph.c",
                "src/contact.c",
                "src/contact_solver.c",
                "src/core.c",
                "src/distance.c",
                "src/distance_joint.c",
                "src/dynamic_tree.c",
                "src/geometry.c",
                "src/hull.c",
                "src/id_pool.c",
                "src/island.c",
                "src/joint.c",
                "src/manifold.c",
                "src/math_functions.c",
                "src/motor_joint.c",
                "src/mover.c",
                "src/mover_joint.c",
                "src/parallel_for.c",
                "src/physics_world.c",
                "src/pogo_joint.c",
                "src/prismatic_joint.c",
                "src/recording.c",
                "src/replay.c",
                "src/revolute_joint.c",
                "src/scheduler.c",
                "src/sensor.c",
                "src/shape.c",
                "src/snapshot.c",
                "src/solver.c",
                "src/solver_set.c",
                "src/table.c",
                "src/timer.c",
                "src/types.c",
                "src/weld_joint.c",
                "src/wheel_joint.c",
            ],
            defines = string.["BOX2D_VALIDATE"],
            generated_entry = "cpp_transpiler_program.jai",
        }],
        output_url = "git@github.com:Jai-Ports/box2d.git",
        supported_target = "linux-x64",
    };
}
